# ================================================
# HeartShop 統一環境設定範本
# 複製此檔案為 .env，並修改為你的本機設定
# AWS 部署時由 ECS Task Definition / Parameter Store 注入，不需此檔案
# ================================================

# --- 後端資料庫連線 ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=heartshop
DB_USERNAME=admin
DB_PASSWORD=admin123

# --- JWT 密鑰（正式環境請換成高強度隨機字串） ---
JWT_SECRET=HeartShop-Super-Secret-Key-For-Development-Environment-Change-This-In-Production-64Bytes

# --- API 伺服器地址（前端使用，不含 /api 路徑） ---
VITE_API_BASE_URL=http://localhost:8080

# --- 後端公開地址（綠界 ReturnURL / OrderResultURL 用，AWS 部署後改為 EC2 IP 或網域） ---
SERVER_URL=http://localhost:8080

# --- 前端網址（後端付款回調用，AWS 部署後改為 EC2 IP 或網域） ---
FRONTEND_URL=http://localhost:3000

# --- CORS 允許的來源（逗號分隔，AWS 部署後改為 EC2 IP 或網域） ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- 圖片上傳目錄（EC2 上設為 /home/ubuntu/heartshop/uploads） ---
UPLOAD_DIR=uploads

# --- Admin 面板地址 ---
VITE_ADMIN_URL=http://localhost:5173
